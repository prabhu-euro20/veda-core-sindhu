# Vendored/built toolchain -- GCC, Spike, Sail C emulator, opam packages.
# Not our own source; regenerable from upstream. toolchain/sail-riscv/ and
# toolchain/llvm-project/ are also their own separate, real git repos
# (Veda extension source is committed there, not tracked from here) --
# toolchain/* (glob, not a trailing-slash directory exclude) so that
# toolchain/setup.sh, our own hand-written orchestration script, can be
# re-included below; a trailing-slash `toolchain/` exclude would make
# that negation impossible per git's own real gitignore semantics.
toolchain/*
!toolchain/setup.sh

# Pre-existing riscof+Spike scaffold (predates ACT4, unrelated to our work)
# and the ACT4 conformance framework + its generated ELFs -- both large,
# vendored/built, not our own source.
verify/
act4-verify/

# Reference material (e.g. the CHERI ISA spec PDF) -- large binary,
# not our own source.
specs/

# Root-level build/log artifacts.
*.log

# RTL/Sail build artifacts under any sim/ directory: SandPiper-transpiled
# SystemVerilog (every .sv file except our own hand-written testbenches,
# tb_*.sv -- this project's own source is TL-Verilog, not SystemVerilog,
# so every non-tb .sv file here is generated output), compiled sims,
# ELF/hex/object files, and SandPiper's own intermediate stub files --
# all regenerated by run_*.sh scripts. Test sources (*.S), the real
# TL-Verilog source (*.tlv), encoder scripts (*.py), run scripts, and
# docs are real source and stay tracked.
**/sim/*.sv
!**/sim/tb_*.sv
**/sim/*.vh
**/sim/*.vvp
**/sim/*.elf
**/sim/*.hex
**/sim/*.o
**/sim/_novz.tlv

# Sail-side test build artifacts (veda-core/sail_tests/) -- compiled by
# run_veda_selfcheck_tests.sh; *.S sources and the .ld/.json/.py/.sh
# fixtures stay tracked.
veda-core/sail_tests/*.elf
veda-core/sail_tests/*.o

# Python bytecode cache.
__pycache__/
*.pyc

# Local virtualenvs
**/.venv/
act4-verify/.venv/

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs, logs and caches
*/build/
**/build/
*.log
*.tmp
*.cache/
.cache/
.pytest_cache/

# Compiled objects and archives
*.o
*.so
*.a
*.dSYM/

# Large vendored toolchains and installed packages (do not push)
toolchain/opam-root/
toolchain/act4-bin/
toolchain/opam-bin/
toolchain/spike-install/
toolchain/bundle-gems/
toolchain/riscv-collab-gcc/
toolchain/*/opam-root/

# Other vendored or generated dependencies
verify/
act4-verify/
toolchain/*/build/

# Misc
*.egg-info/
*.whl
dist/
node_modules/
veda-core/security_trap_demo/

# R29: artifacts of the from-source assembly step added to
# rtl/run_veda_smoke_test.sh. The .S files are the source of truth; .elf/.hex
# and the assembler's stderr capture are all rebuilt on every run.
**/sim/*.elf
**/sim/*.aserr
**/difftest/*.aserr
# rundiff.sh rebuilds this from the current veda_core.sv every run. Committed,
# it let a "differential" run compare a current Sail model against RTL of some
# unknown vintage.
**/difftest/*.vvp
**/difftest/*.o
